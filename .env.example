# copy to .env and fill in. never commit .env
SIGNET_APIKEY=          # python -c "import secrets;print(secrets.token_urlsafe(32))"
SIGNET_DOMAIN=sign.example.com
SIGNET_PUBLIC_URL=https://sign.example.com
SIGNET_MAIL=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=sign@example.com
# optional tuning
# SIGNET_LINK_TTL=2592000
# SIGNET_OTP_TTL=600
# SIGNET_MAX_UPLOAD=20971520
# SIGNET_RATE_ENVELOPES=120
# SIGNET_RATE_OTP=20
# SIGNET_RATE_VERIFY=60
# SIGNET_BACKUP_DIR=/data/backups
